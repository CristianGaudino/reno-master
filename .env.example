# Copy to .env.local (git-ignored) and fill in.
# Loaded by server/env.ts, which gives .env.local precedence over .env.

# Neon connection string — use the POOLED endpoint (the host contains "-pooler").
# https://console.neon.tech -> Project -> Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Port the local API server listens on. Vite proxies /api here in development.
PORT=8787

# Dev-only stand-in for Clerk: any string, identifies the local user.
# Delete once Clerk is wired up — see server/middleware/auth.ts.
DEV_USER_ID="dev-user"
